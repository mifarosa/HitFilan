rules_version = '2';

// HitFilan cloud backup (js/sync.js). Each signed-in user can only reach
// users/{their uid}/items; one document per record:
//   { kind: 'settings'|'history'|'plan'|'goal', data: JSON string or null,
//     updatedAt: int (ms), deleted: bool }
// Paste into Firebase console > Firestore Database > Rules and publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/items/{itemId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && itemId.size() <= 80
        && request.resource.data.keys().hasOnly(['kind', 'data', 'updatedAt', 'deleted'])
        && request.resource.data.kind in ['settings', 'history', 'plan', 'goal']
        && (request.resource.data.data == null
            || (request.resource.data.data is string && request.resource.data.data.size() <= 200000))
        && request.resource.data.updatedAt is int
        && request.resource.data.deleted is bool;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
